# =====================================================================
# Karighar — environment variables (.env.example)
# Copy to .env.local and fill in your own values:
#   cp .env.example .env.local
# Never commit .env.local. The service-role / secret keys must stay
# server-side only — they bypass Row-Level Security.
# =====================================================================

# --- Supabase (required for auth, booking, providers) -----------------
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# Supabase → Project Settings → API → publishable key (or legacy anon key).
# The app accepts EITHER name — set one of the two.
# Publishable key (recommended):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# ...or legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# --- Supabase privileged keys (scripts ONLY — never expose) -----------
# Supabase → Project Settings → API → service_role key (keep secret!).
# Used by scripts/seed.mjs (demo accounts) and scripts/shot-mobile-*.mjs.
# scripts/seed.mjs accepts either SUPABASE_SERVICE_ROLE_KEY or
# SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_your_key_here

# --- Google Maps (required for map features) --------------------------
# Google Cloud Console → APIs & Services → enable:
#   Maps JavaScript API, Geocoding API, Directions API.
# Used for: booking location pin, live provider tracking, jobs map,
# provider directions. If unset, map UI reports that it needs enabling.
# If you set HTTP-referrer restrictions, allow your domains, e.g.
# http://localhost:3000/* and https://your-production-domain/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-key

# --- Site URL (optional) ----------------------------------------------
# Canonical public URL of the deployment. Used by sitemap.xml and
# robots.txt generation. Defaults sensibly for localhost if unset.
# NEXT_PUBLIC_SITE_URL=https://karighar.example.com

# --- Demo recording scripts (optional, local dev only) ----------------
# Base URL of the running dev server for scripts/record.mjs
# (Playwright walkthrough videos). Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# --- Deploy helper (optional) -----------------------------------------
# Used only by scripts/deploy.mjs for Vercel deployments.
# Generate at Vercel → Account Settings → Tokens.
# VERCEL_TOKEN=your-vercel-token

# --- Google OAuth (NOT an env var — Supabase dashboard) ---------------
# The "Continue with Google" button is configured in the Supabase
# dashboard, not here: Supabase → Authentication → Providers → Google,
# paste your Google OAuth client ID + client secret, and add
# https://YOUR-PROJECT.supabase.co/auth/v1/callback as an authorized
# redirect URI in Google Cloud Console.
